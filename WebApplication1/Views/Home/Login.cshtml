@{
    ViewData["Title"] = "拓元實名制 - 會員中心";
}

<div class="container mt-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold text-dark">🔑 售票系統會員中心</h2>
        <p class="text-muted">搶票前請務必先登入或註冊您的會員帳號</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success text-center fw-bold">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center fw-bold">@TempData["Error"]</div>
    }

    <div class="row g-5 justify-content-center mt-2">
        <div class="col-md-5 border-end">
            <div class="p-3">
                <h4 class="fw-bold text-primary mb-4">👤 會員登入</h4>
                <form action="@Url.Action("LoginUser", "Home")" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">會員帳號 (MemberID)</label>
                        <input type="text" name="memberId" class="form-control" required placeholder="例如：M001" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">登入密碼</label>
                        <input type="password" name="password" class="form-control" required placeholder="請輸入密碼" />
                        <div class="form-text">預設測試帳號（M001/M002）的密碼為 1234。</div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold mt-3">立即登入</button>
                </form>
            </div>
        </div>

        <div class="col-md-5">
            <div class="p-3">
                <h4 class="fw-bold text-success mb-4">✨ 新朋友註冊</h4>
                <form action="@Url.Action("RegisterUser", "Home")" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">自訂會員帳號</label>
                        <input type="text" name="memberId" class="form-control" required placeholder="例如：M003" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">真實姓名</label>
                        <input type="text" name="memberName" class="form-control" required placeholder="例如：林大雄" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">設定密碼</label>
                        <input type="password" name="password" class="form-control" required placeholder="請設定您的登入密碼" />
                    </div>
                    <button type="submit" class="btn btn-success btn-lg w-100 fw-bold mt-3">加入會員</button>
                </form>
            </div>
        </div>
    </div>
</div>